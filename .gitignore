# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.xeno/
python_models/.cache/

# Audio / dataset binaries
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Raw downloads / scraped datasets
audio_dataset/raw_downloads/
audio_dataset/originals/
data/uscraping/parquet/
data/uscraping/download.log

# Large data files
*.parquet
*.zip

# Generated caches
data/features/real_corpus_cache.json

# Runtime artifacts
database/*.db
audio_dataset/data/
data/tmp/
# SQLite WAL sidecars (db itself ignored via database/*.db)
database/*.db-shm
database/*.db-wal

# Runtime storage (uploads/live/exports/visuals caches)
data/storage/

# Not-audio junk
sample_audio/invalid.notaudio

# Preprocessed-waveform and embedding caches (rebuilt by python_models/preprocess_cache.py)
data/cache/
audio_dataset/augmented/

# Local secrets
.env

# Sample clips are CC0/CC-BY test recordings listed in sample_audio/SOURCES.csv (SRS: permitted sample audio)
!sample_audio/*.wav
