# Copy to .env (never commit .env) or export these in your shell before starting the app.
# Leave SST_SECRET_KEY empty only for local development; production mode refuses to start
# without it. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SST_SECRET_KEY=
# 1 = production: requires SST_SECRET_KEY, sets secure cookies (serve over HTTPS)
SST_PRODUCTION=0
# Number of trusted reverse proxies in front of the app (0 = serve directly).
# The client IP for audit logs, rate limiting and microphone consent is read from
# X-Forwarded-For only when this says proxies are present; with 0 the socket peer
# address is used, so a spoofed header can never impersonate a client.
SST_TRUSTED_PROXY_HOPS=0

# Where data lives (defaults shown)
SST_DB_PATH=database/sonicsentinel.db
SST_STORAGE_DIR=data/storage

# Demo accounts are read from this file by database/init_db.py. Replace it before any
# public deployment; the default file publishes evaluator passwords on purpose.
SST_SEED_CREDENTIALS=database/seed_credentials.json

# PANNs CNN14 checkpoint, only needed for the older CNN14 models (tools/fetch_pretrained.py).
# The served AST model is downloaded from Hugging Face on first use.
SST_PANNS_CHECKPOINT=
# 0 = start the web app without loading models (UI work, tests)
SST_LOAD_MODELS=1
SST_LOG_LEVEL=INFO
